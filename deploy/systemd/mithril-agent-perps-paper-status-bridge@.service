[Unit]
Description=Mithril bounded %I perps paper status bridge
Requires=mithril-agent-perps-paper-status@%i.socket
After=mithril-agent-perps-paper-status@%i.socket mithril-agent-perps-paper.service
StartLimitIntervalSec=30s
StartLimitBurst=12

[Service]
Type=simple
User=mithril-agent-status-bridge
Group=mithril-agent-status-bridge
UMask=0077
LoadCredential=paper-status:/var/lib/mithril-agent-perps-paper/published/%i-paper-status.json
InaccessiblePaths=/var/lib/mithril-agent
InaccessiblePaths=/var/lib/mithril-agent-research
InaccessiblePaths=-/etc/mithril-agent
InaccessiblePaths=-/var/lib/mithril-agent-perps-paper
ExecStart=/usr/local/libexec/mithril-agent/mithril-agent-paper-status-bridge --credential paper-status
Restart=no
RuntimeMaxSec=5s
TimeoutStartSec=5s
TimeoutStopSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
LockPersonality=yes
CPUAccounting=yes
CPUQuota=10%
IOAccounting=yes
IOWriteBandwidthMax=/ 64K
MemoryAccounting=yes
MemoryDenyWriteExecute=yes
MemoryMax=64M
MemorySwapMax=0
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=~socket socketpair connect bind listen
SystemCallArchitectures=native
TasksMax=16
LimitNOFILE=16
