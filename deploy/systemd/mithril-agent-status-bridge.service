[Unit]
Description=Mithril bounded operator status bridge
Requires=mithril-agent-status.socket
After=mithril-agent-status.socket mithril-agent-swap.service
StartLimitIntervalSec=30s
StartLimitBurst=12

[Service]
Type=simple
User=mithril-agent-status-bridge
Group=mithril-agent-status-bridge
UMask=0077
LoadCredential=operator-status:/var/lib/mithril-agent/agent/state/events.jsonl.status.json
InaccessiblePaths=/var/lib/mithril-agent
InaccessiblePaths=-/etc/mithril-agent
ExecStart=/usr/local/libexec/mithril-agent/mithril-agent-status-bridge --credential operator-status
Restart=no
RuntimeMaxSec=5s
TimeoutStartSec=5s
TimeoutStopSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
LockPersonality=yes
CPUAccounting=yes
CPUQuota=10%
IOAccounting=yes
IOWriteBandwidthMax=/ 64K
MemoryAccounting=yes
MemoryDenyWriteExecute=yes
MemoryMax=64M
MemorySwapMax=0
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=~socket socketpair connect bind listen
SystemCallArchitectures=native
TasksMax=16
LimitNOFILE=16
