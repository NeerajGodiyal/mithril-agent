[Unit]
Description=Mithril bounded research service dashboard projection

[Service]
Type=oneshot
User=mithril-agent-dashboard
Group=mithril-agent-dashboard
UMask=0077
RuntimeDirectory=mithril-agent-dashboard
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/libexec/mithril-agent/mithril-agent-paper-dashboard --record-research-attempt /run/mithril-agent-dashboard/research-attempt.json
TimeoutStartSec=10s
InaccessiblePaths=-/var/lib/mithril-agent-research
InaccessiblePaths=-/etc/mithril-agent
InaccessiblePaths=-/var/log/journal
InaccessiblePaths=-/run/log/journal
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
LockPersonality=yes
CPUAccounting=yes
CPUQuota=10%
IOAccounting=yes
IOWriteBandwidthMax=/ 64K
MemoryAccounting=yes
MemoryDenyWriteExecute=yes
MemoryMax=64M
MemorySwapMax=0
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
TasksMax=16
LimitNOFILE=16
