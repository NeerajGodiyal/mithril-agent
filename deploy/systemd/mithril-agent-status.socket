[Unit]
Description=Mithril bounded operator status socket

[Socket]
ListenStream=/run/mithril-agent-status.sock
SocketUser=root
SocketGroup=mithril-agent-status
SocketMode=0660
FileDescriptorName=operator-status
Service=mithril-agent-status-bridge.service
Accept=no
Backlog=8
FlushPending=no
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
