[Unit]
Description=Mithril Devnet quote service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=mithril-agent-quote
Group=mithril-agent-quote
UMask=0077
EnvironmentFile=/etc/mithril-agent/quote.env
ExecStart=/usr/local/libexec/mithril-agent/mithril-agent-quote --socket /run/mithril-agent-quote/quote.sock --node-command /usr/local/libexec/mithril-agent/node --quote-script /usr/local/libexec/mithril-agent/quote.mjs
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillMode=control-group
RuntimeDirectory=mithril-agent-quote
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectProc=invisible
InaccessiblePaths=-/var/lib/mithril-agent -/etc/mithril-agent/rpc.env
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
IPAccounting=yes
# Permit local DNS only; block node, metadata, and private-network services.
IPAddressDeny=127.0.0.0/8
IPAddressDeny=::1/128
IPAddressDeny=0.0.0.0/8
IPAddressDeny=10.0.0.0/8
IPAddressDeny=100.64.0.0/10
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=169.254.0.0/16
IPAddressDeny=198.18.0.0/15
IPAddressDeny=240.0.0.0/4
IPAddressDeny=fc00::/7
IPAddressDeny=fec0::/10
IPAddressDeny=fe80::/10
IPAddressAllow=127.0.0.53/32
IPAddressAllow=127.0.0.54/32
MemoryDenyWriteExecute=no
MemoryAccounting=yes
MemoryHigh=800M
MemoryMax=1G
MemorySwapMax=0
CPUAccounting=yes
CPUQuota=200%
IOAccounting=yes
IOWeight=10
SystemCallArchitectures=native
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
