[Unit]
Description=Mithril bounded %I provisional market paper experiment
Wants=network-online.target
After=network-online.target time-sync.target
ConditionPathExists=/etc/mithril-agent/market-paper-%i.env
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=mithril-agent-research
Group=mithril-agent-research
UMask=0077
EnvironmentFile=/etc/mithril-agent/paper.env
EnvironmentFile=/etc/mithril-agent/market-paper-%i.env
Environment=MITHRIL_AGENT_KRAKEN_RATE_STATE=/run/mithril-agent-research/kraken-rate
Environment=MITHRIL_AGENT_JUPITER_RATE_STATE=/run/mithril-agent-research/jupiter-rate
RuntimeDirectory=mithril-agent-research
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=mithril-agent-market-paper-%i
StateDirectoryMode=0700
ExecStart=/usr/local/libexec/mithril-agent/mithril-agent shadow run --policy ${MITHRIL_AGENT_PAPER_POLICY} --dir ${MITHRIL_AGENT_PAPER_RUN_DIR} --portfolio ${MITHRIL_AGENT_PAPER_PORTFOLIO} --portfolio-book %i --provisional-artifact ${MITHRIL_AGENT_PAPER_ARTIFACT} --provisional-journal /var/lib/mithril-agent-research/market-admission-%i/evidence.jsonl --paper-check-artifact ${MITHRIL_AGENT_PAPER_CHECK} --alert-status /var/lib/mithril-agent-market-paper-%i/alerts.json
Restart=no
RuntimeMaxSec=24h
TimeoutStartSec=30s
TimeoutStopSec=30s
ReadOnlyPaths=/var/lib/mithril-agent-research/market-admission-%i
ReadWritePaths=/var/lib/mithril-agent-market-paper-%i
InaccessiblePaths=/proc
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateMounts=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
LockPersonality=yes
CPUAccounting=yes
CPUQuota=40%
IOAccounting=yes
MemoryAccounting=yes
MemoryDenyWriteExecute=yes
MemoryMax=192M
MemorySwapMax=0
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
TasksMax=48
LimitNOFILE=96
