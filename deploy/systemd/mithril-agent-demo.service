[Unit]
Description=Mithril bounded Devnet demonstration
After=network-online.target mithril-agent-quote.service mithril-agent-swap.service
Wants=network-online.target
Requires=mithril-agent-quote.service mithril-agent-swap.service

[Service]
Type=oneshot
User=mithril-agent
Group=mithril-agent
UMask=0077
EnvironmentFile=/etc/mithril-agent/rpc.env
EnvironmentFile=-/etc/mithril-agent/mcp.env
EnvironmentFile=-/etc/mithril-agent/price.env
InaccessiblePaths=-/etc/mithril-agent/quote.env
ExecStart=/usr/local/libexec/mithril-agent/mithril-agent demo --config /var/lib/mithril-agent/agent/config.json
ExecStopPost=/usr/local/libexec/mithril-agent/mithril-agent swap stop --config /var/lib/mithril-agent/agent/config.json --reason demo_service_stop
TimeoutStartSec=21min
TimeoutStopSec=30s
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=no
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectProc=invisible
ReadOnlyPaths=/var/lib/mithril-agent/agent
ReadWritePaths=/var/lib/mithril-agent/agent/state
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
IPAccounting=yes
IPAddressDeny=0.0.0.0/8
IPAddressDeny=10.0.0.0/8
IPAddressDeny=100.64.0.0/10
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=169.254.0.0/16
IPAddressDeny=198.18.0.0/15
IPAddressDeny=240.0.0.0/4
IPAddressDeny=fc00::/7
IPAddressDeny=fec0::/10
IPAddressDeny=fe80::/10
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
MemoryAccounting=yes
MemoryMax=256M
MemorySwapMax=0
CPUAccounting=yes
CPUQuota=100%
IOAccounting=yes
TasksMax=64
LimitNOFILE=1024
